{
  // Rust 学习项目：只开 rust-analyzer 提供 Rust 跳转（配合全局 enable_language_server: false）
  "languages": {
    "Rust": {
      "enable_language_server": true,
      "language_servers": ["rust-analyzer"]
    }
  },
  // 压内存：关保存时 cargo check 子进程、关 proc-macro 展开（本项目纯标准库用不到）
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": false,
        "procMacro": { "enable": false },
        "cargo": { "allTargets": false }
      }
    }
  }
}
